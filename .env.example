# Copy to .env and fill in. Only VITE_-prefixed vars are read by Vite, and
# every one of them is compiled into the public JS bundle — so nothing secret
# can ever live here. Server-side secrets (Stripe, Resend, Anthropic, the
# service-role key) belong in Supabase Edge Function secrets, never in this file.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from Supabase dashboard → Project Settings → API>
