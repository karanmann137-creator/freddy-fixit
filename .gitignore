# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment. The repo is PUBLIC — nothing named .env belongs in it.
# Only VITE_* vars are used and they ship in the JS bundle anyway, but the
# rule has to exist so the day a real secret lands here it is not published.
# See .env.example for the shape.
.env
.env.*
!.env.example

# Installer and repair scripts. These are one-shot deploy artifacts, not source.
# Previously 13 were listed BY NAME, which is why 52 of them ended up tracked.
# fix-*.sh is here because the first script written after that cleanup was
# fix-github-login.sh, which the apply-*.sh glob did not catch — a `git add -A`
# would have published it on the very next commit.
apply-*.sh
fix-*.sh
cleanup-freddy-folders.sh
install-skills.sh

# Local agent tooling — machine-specific, regenerated, not project source.
.claude/
.claude-flow/
.swarm/
*.db

# Supabase CLI scratch
supabase/.temp/

# Load testing artifacts
loadtest-*.js
loadtest-*.json

# Marketing / owner deliverables. Binary, unreviewable in a diff, and they
# live on the owner's Desktop as the working copy.
*.docx
*.pages

# Contractor / client contact lists. PII must never reach a public repo.
*.csv

# private security audit - never commit to the public repo
SECURITY-AUDIT-PRIVATE.md
AUTH_SETUP.md
_skills-to-install/

# Design scratch. Standalone HTML mockups written to let the owner SEE a choice
# before it is built — not source, never imported, and `git add -A` would have
# published them to a PUBLIC repo on the very next ship. Named with the -shapes
# / -preview suffixes rather than a bare *.html glob, because index.html is
# tracked and load-bearing.
*-shapes.html
*-preview.html

# Python bytecode from tools/
__pycache__/
*.pyc

# Weekly site reviews. Disposable snapshots, not source, and they carry operational
# detail that does not belong in a public repo. tools/ship.py prunes them past 3 weeks
# by the date in the filename, always keeping the newest one. reference/README.md is
# tracked so the folder survives a fresh clone.
reference/reviews/*.md

# Staging area for files being removed from the repo. Ignored so that
# `git add -A` records the ORIGINAL paths as deletions and never re-adds the
# copies sitting here. The installer moves this whole folder out of the repo
# after a successful push; until then it is the undo button.
_quarantine/
